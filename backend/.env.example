# Copy to .env and fill in real values. NEVER commit .env.
PORT=5000
NODE_ENV=development
# Bind address. Keep 127.0.0.1 when Nginx runs on the same server.
HOST=127.0.0.1
DATABASE_URL="postgresql://hostapp_user:CHANGE_ME@localhost:5432/hostapp_dev?schema=public"
# Generate each with: openssl rand -base64 48
JWT_SECRET=
COOKIE_SECRET=
FRONTEND_URL=http://localhost:3000
# Optional. Defaults to true in production. Set false ONLY while testing over plain HTTP before SSL.
# COOKIE_SECURE=false
